// Shared value-noise helpers for the procedural background shaders.

// Integer hash: exact for any lattice point, so neighbouring cells always
// agree on shared corners (float sin/fract hashes lose precision and leave
// visible seams at larger coordinates).
float hash21(vec2 p) {
	uvec2 q = uvec2(ivec2(p)) * uvec2(1597334673u, 3812015801u);
	uint n = (q.x ^ q.y) * 1597334673u;
	return float(n) * (1.0 / 4294967295.0);
}

float vnoise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = hash21(i);
	float b = hash21(i + vec2(1.0, 0.0));
	float c = hash21(i + vec2(0.0, 1.0));
	float d = hash21(i + vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p) {
	float value = 0.0;
	float amp = 0.5;
	// Rotating each octave hides the axis-aligned grid of value noise.
	mat2 rot = mat2(vec2(0.8, 0.6), vec2(-0.6, 0.8));
	for (int i = 0; i < 5; i++) {
		value += amp * vnoise(p);
		p = rot * p * 2.03 + vec2(17.1, 9.7);
		amp *= 0.5;
	}
	return value;
}
