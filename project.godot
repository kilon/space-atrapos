; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Atrapos"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[audio]

general/default_playback_type.web=0

[autoload]

Mods="*res://scripts/core/mods.gd"
Settings="*res://scripts/core/settings.gd"
SaveGame="*res://scripts/core/save_game.gd"
ProcArt="*res://scripts/core/proc_art.gd"
Galaxy="*res://scripts/sim/galaxy.gd"
Sfx="*res://scripts/core/sfx.gd"
Music="*res://scripts/core/music.gd"
Voice="*res://scripts/core/voice.gd"
Fleets="*res://scripts/sim/fleets.gd"
People="*res://scripts/sim/people.gd"
Keybinds="*res://scripts/core/keybinds.gd"
LiveLink="*res://scripts/core/live_link.gd"
Touch="*res://scripts/core/touch_controls.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.05, 1)

[threading]

worker_pool/low_priority_thread_ratio=0.6
worker_pool/low_priority_thread_ratio.web=0.6
